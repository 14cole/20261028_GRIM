# Python and test caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Native build intermediates; selected Windows and Linux libraries are shipped
*.dll
!/tools/GHOST/ghost_backend/twod/assembly/native/ghost_far.dll
!/tools/GHOST/ghost_backend/twod/assembly/native/ghost_near.dll
!/tools/GHOST/ghost_backend/twod/assembly/native/ghost_table.dll
!/tools/GHOST/ghost_backend/bor/native/bor_stream_kernel.windows-amd64.dll
*.so
!/tools/GHOST/ghost_backend/twod/assembly/native/libghost_far.so
!/tools/GHOST/ghost_backend/twod/assembly/native/libghost_near.so
!/tools/GHOST/ghost_backend/twod/assembly/native/libghost_table.so
!/tools/GHOST/ghost_backend/bor/native/bor_stream_kernel.linux-x86_64.so
*.dylib
*.pyd
*.o
*.obj
*.egg-info/
build/
dist/

# Local secrets, editor state, and transient files
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
.vscode/
.idea/
*.lock
*.tmp
.DS_Store
Thumbs.db

# Generated solver output beside geometry inputs; validation fixtures are retained
/tools/GHOST/ghost_backend/geometry/geometries/*_rcs_*.grim

# Local development output
**/audit_*/
**/*_audit/
**/*_Audit/
**/trials/
**/scratch/

# Review material and development suites are maintained outside this distribution
/audits/
/SOLVER_AUDIT_2D_BOR.md
**/tests/
