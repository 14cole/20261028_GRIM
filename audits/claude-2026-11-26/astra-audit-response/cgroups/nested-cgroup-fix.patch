+def _read_text(path: 'str') -> 'Optional[str]':
+    try:
+        with open(path) as stream:
+            return stream.read()
+    except OSError:
+        return None
+
+
+def _mountinfo_unescape(text: 'str') -> 'str':
+    # /proc/self/mountinfo writes space, tab, newline and backslash as \ooo.
+    return re.sub(r'\\([0-7]{3})', lambda match: chr(int(match.group(1), 8)), text)
+
+
+def _cgroup_memory_directories() -> 'list':
+    """Directories of this process's memory cgroup and its visible ancestors.
+
+    Each entry is ``(limit_file, usage_file, [leaf, parent, ..., mount point])``
+    for one mounted hierarchy that has a memory controller (cgroup v2, or the
+    v1 ``memory`` controller; a hybrid host can yield both).  The process's
+    group comes from /proc/self/cgroup and is mapped through the mount's root
+    in /proc/self/mountinfo, so a hierarchy mounted from below the global root
+    (a container bind mount or a cgroup namespace) resolves to the right
+    directory.  Ancestors above the mount root are not visible from here.
+    """
+
+    membership = _read_text("/proc/self/cgroup")
+    mounts = _read_text("/proc/self/mountinfo")
+    if membership is None or mounts is None:
+        return []
+    v2_path = None
+    v1_path = None
+    for line in membership.splitlines():
+        parts = line.split(":", 2)
+        if len(parts) != 3:
+            continue
+        if parts[0] == "0" and parts[1] == "":
+            v2_path = parts[2]
+        elif "memory" in parts[1].split(","):
+            v1_path = parts[2]
+    found = []
+    seen = set()
+    for line in mounts.splitlines():
+        left, separator, right = line.partition(" - ")
+        fields = left.split()
+        tail = right.split()
+        if not separator or len(fields) < 5 or len(tail) < 3:
+            continue
+        root = _mountinfo_unescape(fields[3])
+        mount_point = _mountinfo_unescape(fields[4])
+        if tail[0] == "cgroup2":
+            group, names = v2_path, ("memory.max", "memory.current")
+        elif tail[0] == "cgroup" and "memory" in tail[2].split(","):
+            group, names = v1_path, ("memory.limit_in_bytes", "memory.usage_in_bytes")
+        else:
+            continue
+        if group is None or not group.startswith("/") or not root.startswith("/"):
+            continue
+        root = root.rstrip("/")
+        group = group.rstrip("/")
+        if ".." in root.split("/") or ".." in group.split("/"):
+            # The group lies outside this mount or namespace: only the mount
+            # point itself is known to bound this process.
+            relative = ""
+        elif group == root or group.startswith(root + "/"):
+            relative = group[len(root):]
+        else:
+            relative = ""
+        mount_point = mount_point.rstrip("/") or "/"
+        key = (mount_point, relative)
+        if key in seen:
+            continue
+        seen.add(key)
+        directories = []
+        parts = [part for part in relative.split("/") if part]
+        while True:
+            directories.append("/".join([mount_point.rstrip("/")] + parts) or "/")
+            if not parts:
+                break
+            parts.pop()
+        found.append((names[0], names[1], directories))
+    return found
+
