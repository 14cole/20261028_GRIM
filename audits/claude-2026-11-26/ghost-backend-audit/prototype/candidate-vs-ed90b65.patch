diff --git a/tools/GHOST/ghost_backend/execution/residency.py b/tools/GHOST/ghost_backend/execution/residency.py
new file mode 100644
index 0000000..d5ac469
--- /dev/null
+++ b/tools/GHOST/ghost_backend/execution/residency.py
@@ -0,0 +1,92 @@
+"""Measured physical residency of one owned buffer.
+
+Process RSS growth cannot show which arrays are in RAM: pages trimmed from one
+buffer are replaced in the total by any later allocation. Ask the OS about the
+buffer's own pages instead. None means unknown; callers then grant no credit.
+"""
+import ctypes
+import os
+import sys
+
+_CHUNK_PAGES = 1 << 18
+
+
+def _interior(array, page):
+    """Whole pages inside the buffer; partial edge pages are never credited."""
+    start = array.__array_interface__['data'][0]
+    first = -(-start // page) * page
+    return first, max(0, (start + array.nbytes - first) // page)
+
+
+def _posix(array):
+    page = os.sysconf('SC_PAGESIZE')
+    address, pages = _interior(array, page)
+    libc = ctypes.CDLL(None, use_errno=True)
+    mincore = libc.mincore
+    mincore.argtypes = [ctypes.c_void_p, ctypes.c_size_t, ctypes.c_char_p]
+    mincore.restype = ctypes.c_int
+    vector = ctypes.create_string_buffer(_CHUNK_PAGES)
+    resident = 0
+    for offset in range(0, pages, _CHUNK_PAGES):
+        count = min(_CHUNK_PAGES, pages - offset)
+        if mincore(address + offset*page, count*page, vector):
+            return None
+        raw = vector.raw[:count]
+        # Only bit 0 is defined; the other bits are reserved.
+        resident += sum(raw.count(bytes([value])) for value in range(1, 256, 2))
+    return resident*page
+
+
+def _windows(array):
+    from ctypes import wintypes
+
+    class Entry(ctypes.Structure):
+        _fields_ = [('address', ctypes.c_void_p), ('attributes', ctypes.c_size_t)]
+
+    information = ctypes.windll.kernel32.GetSystemInfo
+    class SystemInfo(ctypes.Structure):
+        _fields_ = [('oem', wintypes.DWORD), ('page', wintypes.DWORD), ('low', ctypes.c_void_p),
+                    ('high', ctypes.c_void_p), ('mask', ctypes.c_size_t), ('count', wintypes.DWORD),
+                    ('kind', wintypes.DWORD), ('granularity', wintypes.DWORD),
+                    ('level', wintypes.WORD), ('revision', wintypes.WORD)]
+    system = SystemInfo()
+    information(ctypes.byref(system))
+    page = int(system.page)
+    address, pages = _interior(array, page)
+    kernel = ctypes.windll.kernel32
+    kernel.GetCurrentProcess.restype = wintypes.HANDLE
+    query = ctypes.windll.psapi.QueryWorkingSetEx
+    query.argtypes = [wintypes.HANDLE, ctypes.c_void_p, wintypes.DWORD]
+    query.restype = wintypes.BOOL
+    process = kernel.GetCurrentProcess()
+    chunk = 1 << 16
+    entries = (Entry*chunk)()
+    resident = 0
+    for offset in range(0, pages, chunk):
+        count = min(chunk, pages - offset)
+        for index in range(count):
+            entries[index].address = address + (offset + index)*page
+        if not query(process, entries, count*ctypes.sizeof(Entry)):
+            return None
+        # Bit 0 (Valid): the page is in this process's working set.
+        resident += sum(1 for index in range(count) if entries[index].attributes & 1)
+    return resident*page
+
+
+def resident_bytes(array):
+    """Bytes of ``array``'s own buffer now in physical memory, or None if unknown."""
+    try:
+        import numpy as np
+        if not isinstance(array, np.ndarray) or not array.flags.owndata or not (array.flags.c_contiguous or array.flags.f_contiguous):
+            return None
+        if not array.nbytes:
+            return 0
+        return _windows(array) if sys.platform == 'win32' else _posix(array)
+    except Exception:
+        return None
+
+
+def physical_credit(array):
+    """Credit for a retained buffer: what the OS confirms is resident, else nothing."""
+    measured = resident_bytes(array)
+    return 0 if measured is None else min(int(array.nbytes), int(measured))
